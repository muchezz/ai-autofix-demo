# --- Domain / n8n ---
N8N_HOST=autofix.yourdomain.com
POSTGRES_PASSWORD=change-me-strong
# generate with: openssl rand -hex 24
N8N_ENCRYPTION_KEY=change-me-hex24

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# --- GitHub ---
# Fine-grained PAT scoped to the target repo only:
#   Contents: Read/Write, Pull requests: Read/Write
GH_TOKEN=github_pat_xxxxxxxx

# Shared secret between the GitHub Actions workflow and the n8n webhook.
# generate with: openssl rand -hex 16
# Must match the AUTOFIX_WEBHOOK_SECRET set in GitHub repo Secrets.
AUTOFIX_WEBHOOK_SECRET=change-me-hex16

# --- SMTP notification (used in n8n expressions, not the Code node) ---
AUTOFIX_FROM_EMAIL=autofix@yourdomain.com
AUTOFIX_TO_EMAIL=you@yourdomain.com
